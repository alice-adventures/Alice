with "../../project/alice_common.gpr";
with "../../project/alice_lib.gpr";

with "../config/alice_tests_config.gpr";

project Alice_Unit_Test is

   for Main use ("alice_unit_test.adb");

   for Create_Missing_Dirs use "True";
   for Source_Dirs use (
      "../source/common/**",
      "../source/unit/**"
   );
   for Object_Dir  use Alice_Common.Object_Dir;
   for Exec_Dir    use Alice_Common.Exec_Dir;

   package Compiler is
      for Default_Switches ("Ada")
         use Alice_Common.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Executable ("alice_unit_test") use "alice-unit-test";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Alice_Unit_Test;
